From 4298826f65fd4dcea9d91f6f91fb04372bb0a31b Mon Sep 17 00:00:00 2001
From: KSMubasshir <ksmubasshir@gmail.com>
Date: Sat, 17 Oct 2026 16:41:26 -0400
Subject: [PATCH] srsue: reconfigure PRACH for the new cell after a handover

The PRACH buffer is bound to a cell and only reconfigured when the
PRACH configuration changes.  After a handover to a cell with the same
PRACH configuration it kept the source PCI, so is_ready_to_send() never
matched the target PCI, no preamble was sent and T304 expired.

Reconfigure it also when it is set up for a PCI other than the selected
cell's.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 srsue/hdr/phy/prach.h | 2 ++
 srsue/src/phy/phy.cc  | 6 ++++--
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/srsue/hdr/phy/prach.h b/srsue/hdr/phy/prach.h
index 3a6e6aeef..1359eded9 100644
--- a/srsue/hdr/phy/prach.h
+++ b/srsue/hdr/phy/prach.h
@@ -43,6 +43,8 @@ public:
   bool  prepare_to_send(uint32_t preamble_idx, int allowed_subframe = -1, float target_power_dbm = -1);
   bool  is_ready_to_send(uint32_t current_tti, uint32_t current_pci);
   bool  is_pending() const;
+  /// Whether the PRACH is configured for the cell with this PCI.
+  bool  is_configured_for(uint32_t pci) const { return cell_initiated && cell.id == pci; }
   cf_t* generate(float cfo, uint32_t* nof_sf, float* target_power = NULL);
 
   phy_interface_mac_lte::prach_info_t get_info() const;
diff --git a/srsue/src/phy/phy.cc b/srsue/src/phy/phy.cc
index 7840f4db6..372e2fec3 100644
--- a/srsue/src/phy/phy.cc
+++ b/srsue/src/phy/phy.cc
@@ -464,8 +464,10 @@ bool phy::set_config(srslte::phy_cfg_t config_, uint32_t cc_idx)
   // The PRACH shall be re-configured only if:
   // - The new configuration belongs to the primary cell
   // - The PRACH configuration is present
-  // - The PRACH configuration has changed
-  bool reconfigure_prach = !cc_idx && config_.prach_cfg_present && (prach_cfg != config_.prach_cfg);
+  // - The PRACH configuration has changed, or it was set up for another cell (after a handover between cells with
+  //   the same PRACH configuration the PRACH would otherwise keep the source PCI and never transmit)
+  bool reconfigure_prach = !cc_idx && config_.prach_cfg_present &&
+                           (prach_cfg != config_.prach_cfg || !prach_buffer.is_configured_for(selected_cell.id));
 
   if (reconfigure_prach) {
     prach_buffer.reset_cfg();
-- 
