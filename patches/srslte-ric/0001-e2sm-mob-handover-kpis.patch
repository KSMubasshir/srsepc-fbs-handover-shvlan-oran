diff --git a/srsenb/hdr/stack/rrc/rrc_mobility_stats.h b/srsenb/hdr/stack/rrc/rrc_mobility_stats.h
new file mode 100644
index 000000000..840d1421e
--- /dev/null
+++ b/srsenb/hdr/stack/rrc/rrc_mobility_stats.h
@@ -0,0 +1,63 @@
+#ifndef SRSENB_RRC_MOBILITY_STATS_H
+#define SRSENB_RRC_MOBILITY_STATS_H
+
+#include "rrc_metrics.h"
+#include <algorithm>
+#include <sys/time.h>
+
+namespace srsenb {
+
+inline uint64_t rrc_wallclock_ms()
+{
+  struct timeval tv;
+  gettimeofday(&tv, nullptr);
+  return (uint64_t)tv.tv_sec * 1000 + tv.tv_usec / 1000;
+}
+
+/**
+ * Handover counters and a log of the latest handover/re-establishment events
+ * of one eNB.  Only touched from the stack thread (RRC, S1AP and metrics
+ * queries all run there).
+ */
+class rrc_mobility_stats
+{
+public:
+  rrc_ho_counters_t counters = {};
+
+  /// Append an event stamped with the next sequence number and the current
+  /// time; the caller fills in the remaining fields.
+  rrc_ho_event_t& add_event(rrc_ho_event_type_t type, uint16_t rnti)
+  {
+    rrc_ho_event_t& ev = events[(next_seq - 1) % RRC_HO_EVENT_LOG_SIZE];
+    ev                 = {};
+    ev.seq             = next_seq++;
+    ev.time_ms         = rrc_wallclock_ms();
+    ev.type            = type;
+    ev.rnti            = rnti;
+    ev.source_pci      = RRC_INVALID_PCI;
+    ev.target_pci      = RRC_INVALID_PCI;
+    ev.serving_rsrp    = RRC_INVALID_MEAS;
+    ev.target_rsrp     = RRC_INVALID_MEAS;
+    ev.reest_cause     = -1;
+    return ev;
+  }
+
+  void get_metrics(rrc_mobility_metrics_t& m) const
+  {
+    m.counters = counters;
+    m.next_seq = next_seq;
+    m.n_events = std::min<uint32_t>(next_seq - 1, RRC_HO_EVENT_LOG_SIZE);
+    uint32_t first = next_seq - m.n_events;
+    for (uint32_t i = 0; i < m.n_events; i++) {
+      m.events[i] = events[(first + i - 1) % RRC_HO_EVENT_LOG_SIZE];
+    }
+  }
+
+private:
+  rrc_ho_event_t events[RRC_HO_EVENT_LOG_SIZE] = {};
+  uint32_t       next_seq                       = 1;
+};
+
+} // namespace srsenb
+
+#endif // SRSENB_RRC_MOBILITY_STATS_H
