+
+void rrc::ue::rrc_mobility::record_meas_report(const asn1::rrc::meas_results_s& meas_res)
+{
+  rrc_enb->mob_stats.counters.meas_reports++;
+  last_meas.valid                = true;
+  last_meas.time_ms              = rrc_wallclock_ms();
+  last_meas.n_reports++;
+  last_meas.meas_id              = meas_res.meas_id;
+  last_meas.serving.pci          = pcell_pci();
+  last_meas.serving.rsrp_present = true;
+  last_meas.serving.rsrp         = meas_res.meas_result_pcell.rsrp_result;
+  last_meas.serving.rsrq_present = true;
+  last_meas.serving.rsrq         = meas_res.meas_result_pcell.rsrq_result;
+  last_meas.n_neigh              = 0;
+  if (meas_res.meas_result_neigh_cells_present and
+      meas_res.meas_result_neigh_cells.type().value ==
+          meas_results_s::meas_result_neigh_cells_c_::types::meas_result_list_eutra) {
+    for (const meas_result_eutra_s& e : meas_res.meas_result_neigh_cells.meas_result_list_eutra()) {
+      if (last_meas.n_neigh == RRC_MEAS_MAX_NEIGH_CELLS) {
+        break;
+      }
+      rrc_meas_cell_t& c = last_meas.neigh[last_meas.n_neigh++];
+      c.pci              = e.pci;
+      c.rsrp_present     = e.meas_result.rsrp_result_present;
+      c.rsrp             = e.meas_result.rsrp_result;
+      c.rsrq_present     = e.meas_result.rsrq_result_present;
+      c.rsrq             = e.meas_result.rsrq_result;
+    }
+  }
+}
+
+void rrc::ue::rrc_mobility::ho_start(ho_ctxt_t::kind_t kind,
+                                     uint16_t          source_pci,
+                                     uint16_t          target_pci,
+                                     uint32_t          target_eci,
+                                     uint8_t           target_rsrp)
+{
+  // A new attempt while one is open (should not happen): close the old one.
+  ho_finish(false);
+  ho_ctxt            = {};
+  ho_ctxt.kind       = kind;
+  ho_ctxt.start_ms   = rrc_wallclock_ms();
+  ho_ctxt.source_pci = source_pci;
+  ho_ctxt.target_pci = target_pci;
+  ho_ctxt.target_eci = target_eci;
+
+  rrc_ho_counters_t&  cnt  = rrc_enb->mob_stats.counters;
+  rrc_ho_event_type_t type = rrc_ho_event_type_t::intra_start;
+  switch (kind) {
+    case ho_ctxt_t::s1_out:
+      cnt.s1_out_attempt++;
+      type = rrc_ho_event_type_t::s1_out_prep_start;
+      break;
+    case ho_ctxt_t::s1_in:
+      cnt.s1_in_attempt++;
+      type = rrc_ho_event_type_t::s1_in_request;
+      break;
+    default:
+      cnt.intra_attempt++;
+      break;
+  }
+  rrc_ho_event_t& ev = rrc_enb->mob_stats.add_event(type, rrc_ue->rnti);
+  ev.source_pci      = source_pci;
+  ev.target_pci      = target_pci;
+  ev.target_eci      = target_eci;
+  ev.target_rsrp     = target_rsrp;
+  if (last_meas.valid) {
+    ev.serving_rsrp = last_meas.serving.rsrp;
+  }
+}
+
+void rrc::ue::rrc_mobility::ho_exec()
+{
+  if (ho_ctxt.kind == ho_ctxt_t::none or ho_ctxt.exec) {
+    return;
+  }
+  ho_ctxt.exec = true;
+
+  rrc_ho_counters_t& cnt = rrc_enb->mob_stats.counters;
+  rrc_ho_event_type_t type;
+  switch (ho_ctxt.kind) {
+    case ho_ctxt_t::s1_out:
+      cnt.s1_out_prep_success++;
+      type = rrc_ho_event_type_t::s1_out_prep_success;
+      break;
+    case ho_ctxt_t::s1_in:
+      cnt.s1_in_prep_success++;
+      type = rrc_ho_event_type_t::s1_in_prep_success;
+      break;
+    default:
+      // intra-eNB handover has no preparation phase to report
+      return;
+  }
+  rrc_ho_event_t& ev = rrc_enb->mob_stats.add_event(type, rrc_ue->rnti);
+  ev.source_pci      = ho_ctxt.source_pci;
+  ev.target_pci      = ho_ctxt.target_pci;
+  ev.target_eci      = ho_ctxt.target_eci;
+  ev.duration_ms     = (uint32_t)(ev.time_ms - ho_ctxt.start_ms);
+}
+
+void rrc::ue::rrc_mobility::ho_finish(bool success)
+{
+  if (ho_ctxt.kind == ho_ctxt_t::none) {
+    return;
+  }
+  rrc_ho_counters_t&  cnt = rrc_enb->mob_stats.counters;
+  rrc_ho_event_type_t type;
+  switch (ho_ctxt.kind) {
+    case ho_ctxt_t::s1_out:
+      if (not ho_ctxt.exec) {
+        cnt.s1_out_prep_failure++;
+        type = rrc_ho_event_type_t::s1_out_prep_failure;
+      } else if (success) {
+        cnt.s1_out_success++;
+        type = rrc_ho_event_type_t::s1_out_success;
+      } else {
+        cnt.s1_out_failure++;
+        type = rrc_ho_event_type_t::s1_out_failure;
+      }
+      break;
+    case ho_ctxt_t::s1_in:
+      if (not ho_ctxt.exec) {
+        cnt.s1_in_prep_failure++;
+        type = rrc_ho_event_type_t::s1_in_prep_failure;
+      } else if (success) {
+        cnt.s1_in_success++;
+        type = rrc_ho_event_type_t::s1_in_success;
+      } else {
+        cnt.s1_in_failure++;
+        type = rrc_ho_event_type_t::s1_in_failure;
+      }
+      break;
+    default:
+      if (success) {
+        cnt.intra_success++;
+        type = rrc_ho_event_type_t::intra_success;
+      } else {
+        cnt.intra_failure++;
+        type = rrc_ho_event_type_t::intra_failure;
+      }
+      break;
+  }
+  rrc_ho_event_t& ev = rrc_enb->mob_stats.add_event(type, rrc_ue->rnti);
+  ev.source_pci      = ho_ctxt.source_pci;
+  ev.target_pci      = ho_ctxt.target_pci;
+  ev.target_eci      = ho_ctxt.target_eci;
+  ev.duration_ms     = (uint32_t)(ev.time_ms - ho_ctxt.start_ms);
+  ho_ctxt            = {};
+}
+
+void rrc::ue::rrc_mobility::handle_ue_release(bool successful_ho)
+{
+  // Only the source of an S1 handover is released with cause successful-handover.
+  ho_finish(successful_ho and ho_ctxt.kind == ho_ctxt_t::s1_out);
+}
+
+uint16_t rrc::ue::rrc_mobility::pcell_pci() const
+{
+  const cell_info_common* pcell = rrc_ue->get_ue_cc_cfg(UE_PCELL_CC_IDX);
+  return pcell != nullptr ? pcell->cell_cfg.pci : RRC_INVALID_PCI;
+}
+
+rrc_ue_mob_state_t rrc::ue::rrc_mobility::get_mob_state() const
+{
+  if (is_in_state<intraenb_ho_st>()) {
+    return rrc_ue_mob_state_t::intra_enb;
+  }
+  if (is_in_state<s1_target_ho_st>()) {
+    return rrc_ue_mob_state_t::s1_target_prep;
+  }
+  if (is_in_state<wait_recfg_comp>()) {
+    return rrc_ue_mob_state_t::s1_target_exec;
+  }
+  const s1_source_ho_st* src = get_if_current_state<s1_source_ho_st>();
+  if (src != nullptr) {
