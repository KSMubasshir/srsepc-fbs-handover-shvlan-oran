diff --git a/srsenb/hdr/stack/rrc/rrc_metrics.h b/srsenb/hdr/stack/rrc/rrc_metrics.h
index 55c64084c..931e324a6 100644
--- a/srsenb/hdr/stack/rrc/rrc_metrics.h
+++ b/srsenb/hdr/stack/rrc/rrc_metrics.h
@@ -39,16 +39,122 @@ typedef enum {
   RRC_STATE_N_ITEMS,
 } rrc_state_t;
 
+/// Handover state of a UE context, as seen by this eNB.
+enum class rrc_ue_mob_state_t : uint8_t {
+  idle = 0,       ///< no handover in progress
+  s1_source_prep, ///< source: HandoverRequired sent, waiting for HandoverCommand
+  s1_source_exec, ///< source: HO command sent to the UE, waiting for release
+  s1_target_prep, ///< target: HandoverRequest handled, waiting for MME status transfer
+  s1_target_exec, ///< target: waiting for RRCConnectionReconfigurationComplete
+  intra_enb,      ///< intra-eNB handover in progress
+};
+
+/// One cell of a MeasurementReport.  rsrp/rsrq are the TS 36.133 report values
+/// (RSRP 0..97 ~ value-140 dBm, RSRQ 0..34 ~ value/2-20 dB).
+struct rrc_meas_cell_t {
+  uint16_t pci;
+  bool     rsrp_present;
+  uint8_t  rsrp;
+  bool     rsrq_present;
+  uint8_t  rsrq;
+};
+
+#define RRC_MEAS_MAX_NEIGH_CELLS 8
+
+/// Last MeasurementReport received from a UE.
+struct rrc_ue_meas_t {
+  bool            valid;
+  uint64_t        time_ms; ///< wall-clock reception time
+  uint32_t        n_reports;
+  uint8_t         meas_id;
+  rrc_meas_cell_t serving;
+  uint32_t        n_neigh;
+  rrc_meas_cell_t neigh[RRC_MEAS_MAX_NEIGH_CELLS];
+};
+
+/// Cumulative handover counters of this eNB since start.
+struct rrc_ho_counters_t {
+  // S1 handover with this eNB as source
+  uint32_t s1_out_attempt;      ///< HandoverRequired sent
+  uint32_t s1_out_prep_success; ///< HandoverCommand received and sent to the UE
+  uint32_t s1_out_prep_failure; ///< HandoverPreparationFailure, TS1RELOCprep expiry, or local error
+  uint32_t s1_out_success;      ///< UE context released by the MME with cause successful-handover
+  uint32_t s1_out_failure;      ///< UE re-established or was released otherwise after the HO command
+  // S1 handover with this eNB as target
+  uint32_t s1_in_attempt;      ///< HandoverRequest received
+  uint32_t s1_in_prep_success; ///< HandoverRequestAcknowledge sent
+  uint32_t s1_in_prep_failure; ///< HandoverRequest could not be admitted
+  uint32_t s1_in_success;      ///< RRCConnectionReconfigurationComplete received from the UE
+  uint32_t s1_in_failure;      ///< UE context removed before the UE arrived
+  // intra-eNB handover
+  uint32_t intra_attempt;
+  uint32_t intra_success;
+  uint32_t intra_failure;
+  // RRC connection re-establishment
+  uint32_t reest_attempt; ///< RRCConnectionReestablishmentRequest received
+  uint32_t reest_success; ///< RRCConnectionReestablishmentComplete received
+  uint32_t reest_reject;  ///< RRCConnectionReestablishmentReject or RRCConnectionReject sent
+  uint32_t meas_reports;
+};
+
+enum class rrc_ho_event_type_t : uint8_t {
+  s1_out_prep_start = 0,
+  s1_out_prep_success,
+  s1_out_prep_failure,
+  s1_out_success,
+  s1_out_failure,
+  s1_in_request,
+  s1_in_prep_success,
+  s1_in_prep_failure,
+  s1_in_success,
+  s1_in_failure,
+  intra_start,
+  intra_success,
+  intra_failure,
+  reest_request,
+  reest_success,
+  reest_reject,
+};
+
+#define RRC_INVALID_PCI 0xffff
+#define RRC_INVALID_MEAS 0xff
+
+/// A handover or re-establishment event.  Optional fields use RRC_INVALID_*.
+struct rrc_ho_event_t {
+  uint32_t            seq; ///< 1, 2, ... in order of occurrence
+  uint64_t            time_ms;
+  rrc_ho_event_type_t type;
+  uint16_t            rnti;
+  uint16_t            source_pci;
+  uint16_t            target_pci;
+  uint32_t            target_eci;   ///< 0 if unknown
+  uint8_t             serving_rsrp; ///< at the handover decision
+  uint8_t             target_rsrp;  ///< at the handover decision
+  uint32_t            duration_ms;  ///< outcome events: time since the handover started
+  int8_t              reest_cause;  ///< reest_request: 36.331 ReestablishmentCause, -1 otherwise
+};
+
+#define RRC_HO_EVENT_LOG_SIZE 64
+
+struct rrc_mobility_metrics_t {
+  rrc_ho_counters_t counters;
+  uint32_t          next_seq; ///< seq the next event will get
+  uint32_t          n_events; ///< events[0..n_events) hold the latest events, oldest first
+  rrc_ho_event_t    events[RRC_HO_EVENT_LOG_SIZE];
+};
+
 struct rrc_ue_metrics_t {
-  rrc_state_t state;
-#ifdef ENABLE_RIC_AGENT_KPM
-  uint16_t    rnti;
-#endif
+  rrc_state_t        state;
+  uint16_t           rnti;
+  uint16_t           pci; ///< PCell PCI
+  rrc_ue_mob_state_t mob_state;
+  rrc_ue_meas_t      meas;
 };
 
 struct rrc_metrics_t {
-  uint16_t         n_ues;
-  rrc_ue_metrics_t ues[ENB_METRICS_MAX_USERS];
+  uint16_t               n_ues;
+  rrc_ue_metrics_t       ues[ENB_METRICS_MAX_USERS];
+  rrc_mobility_metrics_t mobility;
 };
 
 } // namespace srsenb
