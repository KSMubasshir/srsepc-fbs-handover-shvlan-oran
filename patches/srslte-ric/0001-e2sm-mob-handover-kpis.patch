+mob_model::mob_model(ric::agent *agent_) :
+  service_model(agent_,"ORAN-E2SM-MOB","1.3.6.1.4.1.53148.1.1.2.102"),
+  serial_number(1), lock(PTHREAD_MUTEX_INITIALIZER)
+{
+}
+
+int mob_model::init()
+{
+  ric::ran_function_t *func;
+  E2SM_MOB_RANfunction_Description_t *func_def;
+
+  E2SM_INFO(agent,"mob: building function list\n");
+
+  func = (ric::ran_function_t *)calloc(1,sizeof(*func));
+  func->function_id = get_next_ran_function_id();
+  func->model = this;
+  func->revision = 0;
+  func->name = "ORAN-E2SM-MOB";
+  func->description = "Handover KPIs and events";
+
+  func_def = (E2SM_MOB_RANfunction_Description_t *)calloc(1,sizeof(*func_def));
+  func_def->ranFunction_Name.ranFunction_ShortName.buf = \
+    (uint8_t *)strdup(func->name.c_str());
+  func_def->ranFunction_Name.ranFunction_ShortName.size = \
+    strlen(func->name.c_str());
+  func_def->ranFunction_Name.ranFunction_E2SM_OID.buf = \
+    (uint8_t *)strdup(func->model->oid.c_str());
+  func_def->ranFunction_Name.ranFunction_E2SM_OID.size = \
+    strlen(func->model->oid.c_str());
+  func_def->ranFunction_Name.ranFunction_Description.buf = \
+    (uint8_t *)strdup(func->description.c_str());
+  func_def->ranFunction_Name.ranFunction_Description.size = \
+    strlen(func->description.c_str());
+
+  func->enc_definition_len = ric::e2ap::encode(
+    &asn_DEF_E2SM_MOB_RANfunction_Description,0,
+    func_def,&func->enc_definition);
+  if (func->enc_definition_len < 0) {
+    E2SM_ERROR(agent,"failed to encode %s function %s!\n",
+	       name.c_str(),func->name.c_str());
+    ASN_STRUCT_FREE(asn_DEF_E2SM_MOB_RANfunction_Description,func_def);
+    free(func);
+    return -1;
+  }
+
+  func->enabled = 1;
+  func->definition = func_def;
+  functions.push_back(func);
+
+  queue.start();
+
+  return 0;
+}
+
+void mob_model::stop()
+{
+  pthread_mutex_lock(&lock);
+  queue.stop();
+  for (auto it = subscriptions.begin(); it != subscriptions.end(); ++it) {
+    delete (subscription_model_data_t *)(*it)->model_data;
+    (*it)->model_data = NULL;
+  }
+  subscriptions.clear();
+  pthread_mutex_unlock(&lock);
+}
+
+int mob_model::handle_subscription_add(ric::subscription_t *sub)
+{
+  E2SM_MOB_E2SM_Mob_EventTriggerDefinition_t etdef;
+  bool any_actions_enabled = false;
+  subscription_model_data_t *md;
+  struct timeval tv;
+
+  if (sub->event_trigger.size < 1 || sub->event_trigger.buf == NULL) {
+    E2SM_ERROR(agent,"mob: no report event trigger\n");
+    return -1;
+  }
+
+  memset(&etdef,0,sizeof(etdef));
+  if (ric::e2ap::decode(
+	agent,&asn_DEF_E2SM_MOB_E2SM_Mob_EventTriggerDefinition,&etdef,
+	sub->event_trigger.buf,sub->event_trigger.size)) {
+    E2SM_ERROR(agent,"mob: failed to decode event trigger definition\n");
+    ASN_STRUCT_FREE_CONTENTS_ONLY(
+      asn_DEF_E2SM_MOB_E2SM_Mob_EventTriggerDefinition,&etdef);
+    return -1;
+  }
+  if (etdef.present != E2SM_MOB_E2SM_Mob_EventTriggerDefinition_PR_periodDefinition) {
+    E2SM_ERROR(agent,"mob: unrecognized event trigger definition\n");
+    ASN_STRUCT_FREE_CONTENTS_ONLY(
+      asn_DEF_E2SM_MOB_E2SM_Mob_EventTriggerDefinition,&etdef);
+    return -1;
+  }
+  long period = etdef.choice.periodDefinition.period;
+  ASN_STRUCT_FREE_CONTENTS_ONLY(
+    asn_DEF_E2SM_MOB_E2SM_Mob_EventTriggerDefinition,&etdef);
+
+  for (auto it = sub->actions.begin(); it != sub->actions.end(); ++it) {
+    ric::action_t *action = *it;
+    if (action->type != E2AP_RICactionType_report) {
+      E2SM_WARN(agent,"mob: invalid actionType %ld; not enabling this action\n",
+		action->type);
+      continue;
+    }
+    action->enabled = true;
+    any_actions_enabled = true;
+  }
+  if (!any_actions_enabled) {
+    E2SM_ERROR(agent,"mob: no actions enabled; failing subscription\n");
+    return -1;
+  }
+
+  // Start with whatever is still in the eNB's event log.
+  md = new subscription_model_data_t{period,-1,1};
+
+  pthread_mutex_lock(&lock);
+  subscriptions.push_back(sub);
+  tv = { md->period / 1000, (md->period % 1000) * 1000 };
+  md->timer_id = queue.insert_periodic(tv,timer_callback,this);
+  sub->model_data = md;
+  pthread_mutex_unlock(&lock);
+
+  E2SM_INFO(agent,"mob: added subscription (reqid=%ld,instid=%ld) period %ld ms\n",
+	    sub->request_id,sub->instance_id,period);
+
+  return 0;
+}
+
+int mob_model::handle_subscription_del(
+  ric::subscription_t *sub,int force,long *cause,long *cause_detail)
+{
+  subscription_model_data_t *md = (subscription_model_data_t *)sub->model_data;
+
+  pthread_mutex_lock(&lock);
+  if (md) {
+    queue.cancel(md->timer_id);
+    delete md;
+  }
+  sub->model_data = NULL;
+  subscriptions.remove(sub);
+  pthread_mutex_unlock(&lock);
+
+  return 0;
+}
+
+void *mob_model::timer_callback(int timer_id,void *arg)
+{
+  mob_model *model = (mob_model *)arg;
+  model->agent->push_task([model,timer_id]() { model->send_indications(timer_id); });
+  return NULL;
+}
+
+template <typename T>
+static T *new_opt(long value)
+{
+  T *p = (T *)calloc(1,sizeof(T));
+  *p = value;
+  return p;
+}
+
+static void fill_meas_result(E2SM_MOB_MeasResult_t *mr,const srsenb::rrc_meas_cell_t &c)
+{
+  mr->pci = c.pci;
+  if (c.rsrp_present)
+    mr->rsrp = new_opt<E2SM_MOB_RSRP_t>(c.rsrp);
+  if (c.rsrq_present)
+    mr->rsrq = new_opt<E2SM_MOB_RSRQ_t>(c.rsrq);
+}
+
+static void fill_ue_list(E2SM_MOB_MobilityReport_t *report,
+			 const srsenb::rrc_metrics_t &rm,uint64_t now_ms)
+{
+  for (uint16_t i = 0; i < rm.n_ues && i < ENB_METRICS_MAX_USERS; ++i) {
+    const srsenb::rrc_ue_metrics_t &um = rm.ues[i];
+    E2SM_MOB_UeMobilityStatus_t *ue = \
+      (E2SM_MOB_UeMobilityStatus_t *)calloc(1,sizeof(*ue));
+    ue->rnti = um.rnti;
+    ue->rrcState = um.state;
+    ue->mobilityState = (long)um.mob_state;
+    if (um.pci != RRC_INVALID_PCI)
+      ue->servingPci = new_opt<E2SM_MOB_PCI_t>(um.pci);
+    if (um.meas.valid) {
+      E2SM_MOB_UeMeasReport_t *mrep = \
+	(E2SM_MOB_UeMeasReport_t *)calloc(1,sizeof(*mrep));
+      mrep->ageMs = now_ms > um.meas.time_ms ? now_ms - um.meas.time_ms : 0;
+      mrep->nReports = um.meas.n_reports;
+      mrep->measId = um.meas.meas_id;
+      fill_meas_result(&mrep->serving,um.meas.serving);
+      for (uint32_t j = 0; j < um.meas.n_neigh && j < RRC_MEAS_MAX_NEIGH_CELLS; ++j) {
+	E2SM_MOB_MeasResult_t *mr = (E2SM_MOB_MeasResult_t *)calloc(1,sizeof(*mr));
+	fill_meas_result(mr,um.meas.neigh[j]);
+	ASN_SEQUENCE_ADD(&mrep->neighbours.list,mr);
+      }
+      ue->lastMeasReport = mrep;
+    }
+    ASN_SEQUENCE_ADD(&report->ueList.list,ue);
+  }
+}
+
+/// Add the events with seq >= next_seq; return the seq after the last one.
+static uint32_t fill_event_list(E2SM_MOB_MobilityReport_t *report,
+				const srsenb::rrc_mobility_metrics_t &mm,
+				uint32_t next_seq)
+{
+  uint32_t oldest = mm.next_seq - mm.n_events;
+  if (next_seq < oldest) {
+    report->eventsLost = oldest - next_seq;
+    next_seq = oldest;
+  }
+  for (uint32_t i = next_seq - oldest; i < mm.n_events; ++i) {
+    const srsenb::rrc_ho_event_t &e = mm.events[i];
+    E2SM_MOB_HoEvent_t *ev = (E2SM_MOB_HoEvent_t *)calloc(1,sizeof(*ev));
+    ev->seq = e.seq;
+    ev->timestampSec = e.time_ms / 1000;
+    ev->timestampMs = e.time_ms % 1000;
+    ev->eventType = (long)e.type;
+    if (e.rnti != SRSLTE_INVALID_RNTI)
+      ev->rnti = new_opt<E2SM_MOB_C_RNTI_t>(e.rnti);
+    if (e.source_pci != RRC_INVALID_PCI)
+      ev->sourcePci = new_opt<E2SM_MOB_PCI_t>(e.source_pci);
+    if (e.target_pci != RRC_INVALID_PCI)
+      ev->targetPci = new_opt<E2SM_MOB_PCI_t>(e.target_pci);
+    if (e.target_eci != 0)
+      ev->targetEci = new_opt<E2SM_MOB_ECI_t>(e.target_eci);
+    if (e.serving_rsrp != RRC_INVALID_MEAS)
+      ev->servingRsrp = new_opt<E2SM_MOB_RSRP_t>(e.serving_rsrp);
+    if (e.target_rsrp != RRC_INVALID_MEAS)
+      ev->targetRsrp = new_opt<E2SM_MOB_RSRP_t>(e.target_rsrp);
+    switch (e.type) {
+    case srsenb::rrc_ho_event_type_t::s1_out_prep_start:
+    case srsenb::rrc_ho_event_type_t::s1_in_request:
+    case srsenb::rrc_ho_event_type_t::intra_start:
+    case srsenb::rrc_ho_event_type_t::reest_request:
+    case srsenb::rrc_ho_event_type_t::reest_success:
+    case srsenb::rrc_ho_event_type_t::reest_reject:
+      break;
+    default:
+      ev->durationMs = new_opt<E2SM_MOB_Counter_t>(e.duration_ms);
+    }
+    // 36.331 ReestablishmentCause: reconfigurationFailure, handoverFailure, otherFailure, spare
+    if (e.reest_cause >= 0 && e.reest_cause <= 2)
+      ev->reestCause = new_opt<E2SM_MOB_ReestCause_t>(e.reest_cause);
+    ASN_SEQUENCE_ADD(&report->eventList.list,ev);
+  }
+  return mm.next_seq;
+}
+
+void mob_model::send_indications(int timer_id)
+{
+  ric::subscription_t *sub = NULL;
+  subscription_model_data_t *md = NULL;
+  E2SM_MOB_E2SM_Mob_IndicationHeader_t ih;
+  E2SM_MOB_E2SM_Mob_IndicationMessage_t im;
+  uint8_t *header_buf = NULL;
+  ssize_t header_buf_len = 0;
+  uint8_t *msg_buf = NULL;
+  ssize_t msg_buf_len = 0;
+  uint32_t next_seq;
+
+  pthread_mutex_lock(&lock);
+
+  for (auto it = subscriptions.begin(); it != subscriptions.end(); ++it) {
+    subscription_model_data_t *d = (subscription_model_data_t *)(*it)->model_data;
+    if (d && d->timer_id == timer_id) {
+      sub = *it;
+      md = d;
+      break;
+    }
+  }
+  if (sub == NULL) {
+    E2SM_ERROR(agent,"mob: bogus timer_id %d; ignoring!\n",timer_id);
+    pthread_mutex_unlock(&lock);
+    return;
+  }
+
+  // enb_metrics_t is large; keep it off the agent thread's stack.
+  std::unique_ptr<srsenb::enb_metrics_t> em(new srsenb::enb_metrics_t{});
+  agent->enb_metrics_interface->get_metrics(em.get());
+  const srsenb::rrc_metrics_t &rm = em->stack.rrc;
+  uint64_t now_ms = srsenb::rrc_wallclock_ms();
+
+  memset(&ih,0,sizeof(ih));
+  ih.timestampSec = now_ms / 1000;
+  ih.timestampMs = now_ms % 1000;
+  ih.enbId = agent->rrc_cfg.enb_id;
+
+  memset(&im,0,sizeof(im));
+  im.present = E2SM_MOB_E2SM_Mob_IndicationMessage_PR_mobilityReport;
+  E2SM_MOB_MobilityReport_t *report = &im.choice.mobilityReport;
+
+  for (const auto &cell : agent->rrc_cfg.cell_list) {
+    E2SM_MOB_CellInfo_t *ci = (E2SM_MOB_CellInfo_t *)calloc(1,sizeof(*ci));
+    ci->cellId = cell.cell_id;
+    ci->pci = cell.pci;
+    ci->dlEarfcn = cell.dl_earfcn;
+    ASN_SEQUENCE_ADD(&report->cellList.list,ci);
+  }
+
+  const srsenb::rrc_ho_counters_t &c = rm.mobility.counters;
+  report->counters.s1OutAttempt = c.s1_out_attempt;
+  report->counters.s1OutPrepSuccess = c.s1_out_prep_success;
+  report->counters.s1OutPrepFailure = c.s1_out_prep_failure;
+  report->counters.s1OutSuccess = c.s1_out_success;
+  report->counters.s1OutFailure = c.s1_out_failure;
+  report->counters.s1InAttempt = c.s1_in_attempt;
+  report->counters.s1InPrepSuccess = c.s1_in_prep_success;
+  report->counters.s1InPrepFailure = c.s1_in_prep_failure;
+  report->counters.s1InSuccess = c.s1_in_success;
+  report->counters.s1InFailure = c.s1_in_failure;
+  report->counters.intraAttempt = c.intra_attempt;
+  report->counters.intraSuccess = c.intra_success;
+  report->counters.intraFailure = c.intra_failure;
+  report->counters.reestAttempt = c.reest_attempt;
+  report->counters.reestSuccess = c.reest_success;
+  report->counters.reestReject = c.reest_reject;
+  report->counters.measReports = c.meas_reports;
+
+  fill_ue_list(report,rm,now_ms);
+  next_seq = fill_event_list(report,rm.mobility,md->next_seq);
+
+  E2SM_DEBUG(agent,"mob indication header:\n");
+  E2SM_XER_PRINT(NULL,&asn_DEF_E2SM_MOB_E2SM_Mob_IndicationHeader,&ih);
+  E2SM_DEBUG(agent,"mob indication message:\n");
+  E2SM_XER_PRINT(NULL,&asn_DEF_E2SM_MOB_E2SM_Mob_IndicationMessage,&im);
+
+  header_buf_len = ric::e2ap::encode(
+    &asn_DEF_E2SM_MOB_E2SM_Mob_IndicationHeader,0,&ih,&header_buf);
+  if (header_buf_len < 0) {
+    E2SM_ERROR(agent,"mob: failed to encode indication header\n");
+    goto out;
+  }
+  msg_buf_len = ric::e2ap::encode(
+    &asn_DEF_E2SM_MOB_E2SM_Mob_IndicationMessage,0,&im,&msg_buf);
+  if (msg_buf_len < 0) {
+    E2SM_ERROR(agent,"mob: failed to encode indication message\n");
+    goto out;
+  }
+
+  for (auto it = sub->actions.begin(); it != sub->actions.end(); ++it) {
+    ric::action_t *action = *it;
+    uint8_t *buf = NULL;
+    ssize_t buf_len = 0;
+
+    if (!action->enabled)
+      continue;
+    if (ric::e2ap::generate_indication(
+	  agent,sub->request_id,sub->instance_id,sub->function_id,
+	  action->id,serial_number++,(int)E2AP_RICindicationType_report,
+	  header_buf,header_buf_len,msg_buf,msg_buf_len,NULL,0,&buf,&buf_len)) {
+      E2SM_ERROR(agent,"mob: failed to generate indication (reqid=%ld,instid=%ld,funcid=%ld,actid=%ld)\n",
+		 sub->request_id,sub->instance_id,sub->function_id,action->id);
+      continue;
+    }
+    E2SM_DEBUG(agent,"mob: sending indication (reqid=%ld,instid=%ld,funcid=%ld,actid=%ld)\n",
+	       sub->request_id,sub->instance_id,sub->function_id,action->id);
+    agent->send_sctp_data(buf,buf_len);
+    free(buf);
+  }
+  // Only advance once the events have been sent.
+  md->next_seq = next_seq;
+
+ out:
+  ASN_STRUCT_FREE_CONTENTS_ONLY(asn_DEF_E2SM_MOB_E2SM_Mob_IndicationHeader,&ih);
+  ASN_STRUCT_FREE_CONTENTS_ONLY(asn_DEF_E2SM_MOB_E2SM_Mob_IndicationMessage,&im);
+  free(header_buf);
+  free(msg_buf);
+  pthread_mutex_unlock(&lock);
+}
+
+}
